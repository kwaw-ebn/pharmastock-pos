# Generate independent values using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_at_least_32_random_characters
POSTGRES_PASSWORD=replace_with_a_random_hex_password
# For local backend development; PostgreSQL is used by Docker Compose.
DATABASE_URL=sqlite:///./pharmastock.db
CORS_ORIGINS=http://localhost:5173
# Optional SMTP configuration, required for email password reset.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
# Frontend only: empty uses the same-origin /api endpoint or Vite proxy.
VITE_API_URL=
# Paystack secret belongs only on the backend. Never use a VITE_ variable for it.
PAYSTACK_SECRET_KEY=
PAYMENT_CALLBACK_URL=
# Single-use first-admin setup token, generated randomly; remove after setup.
BOOTSTRAP_TOKEN=
